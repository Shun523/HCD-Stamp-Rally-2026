DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# 任意: SupabaseのCAをPEM形式で渡すと、TLS暗号化に加えて証明書も検証する。
# CAを1行で渡す場合は、改行をバックスラッシュとnの2文字で表す。
# CA未指定の外部DB接続もTLSを必須にする。
# DATABASE_SSL_CA=
PORT=8787
ADMIN_PASSWORD=change-me
DEVICE_KEYS_JSON={"dev-01":"replace-me"}
ACK_TIMEOUT_MS=3000
# 2026-10-14に利用者が選んだ「緩め」の過剰アクセス制限。
ADMIN_MAX_FAILURES=20
ADMIN_FAILURE_WINDOW_MS=600000
SESSION_MAX_NEW_PER_SOURCE=240
SESSION_MAX_NEW_TOTAL=600
SESSION_CREATION_WINDOW_MS=60000
SSE_MAX_CONNECTIONS_PER_SESSION=6
SSE_MAX_CONNECTIONS_TOTAL=1200
MAX_REQUEST_BODY_BYTES=8192
# 接続元判定: Cloud Runの直接URLでは自動で1、ローカルでは自動で0。
# 別のプロキシを追加する場合だけ、実際に信頼できる段数を明示する。
# TRUSTED_PROXY_HOPS=0
# Viteのビルド成果物。Dockerではイメージ内の同じ相対パスを使用します。
WEB_DIST_DIR=web/dist
